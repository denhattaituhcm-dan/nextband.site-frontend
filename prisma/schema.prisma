  ACTIVE
  EXPIRED
  DISABLED
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResourceType {
  PDF
  VIDEO
  AUDIO
  SLIDE
  LINK
  IMAGE
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
