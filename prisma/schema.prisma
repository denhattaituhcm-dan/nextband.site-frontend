  NEW
  CONTACTED
  ENROLLED
  CANCELLED
  ARCHIVED
}

enum RetentionType {
  PLACEMENT
  HOMEWORK
  EXAM
  DRAFT
}

enum RecordingStatus {
  UPLOADING
  ACTIVE
  EXPIRED
  PURGED
}

model SpeakingRecordingAsset {
  id               String          @id @default(uuid())
  storagePath      String?         @unique @map("storage_path")
  referenceType    String          @map("reference_type") // PLACEMENT_SESSION, HOMEWORK_SUBMISSION, EXAM_SUBMISSION, DRAFT
  referenceId      String          @map("reference_id")
  questionId       String?         @map("question_id")
  retentionType    RetentionType   @map("retention_type")
  status           RecordingStatus @default(UPLOADING)
  mimeType         String          @default("audio/webm") @map("mime_type")
  sizeBytes        Int?            @map("size_bytes")
  durationMs       Int?            @map("duration_ms")
  uploadedBy       String?         @map("uploaded_by")
  expiresAt        DateTime        @map("expires_at")
  purgedAt         DateTime?       @map("purged_at")
  lastCleanupError String?         @map("last_cleanup_error")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@index([referenceType, referenceId])
  @@map("speaking_recording_assets")
}

model ExamPolicy {
  id                     String   @id @default(uuid())
  examId                 String   @unique @map("exam_id")
  durationSeconds        Int      @map("duration_seconds")
  submissionGraceSeconds Int      @default(60) @map("submission_grace_seconds")
  allowLateSubmission    Boolean  @default(false) @map("allow_late_submission")
  allowResume            Boolean  @default(true) @map("allow_resume")
  maxAttempts            Int      @default(3) @map("max_attempts")
  strictMode             Boolean  @default(true) @map("strict_mode")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  exam                   Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  @@map("exam_policies")
}

model QuestionVersion {
  id              String   @id @default(uuid())
  questionId      String   @map("question_id")
  versionNumber   Int      @map("version_number")
  questionText    String   @map("question_text")
  questionType    String   @map("question_type")
  optionsJson     String?  @map("options_json")
  correctAnswer   String   @map("correct_answer")
  acceptedAnswers String?  @map("accepted_answers")
  scoringRuleJson String?  @map("scoring_rule_json")
  audioUrl        String?  @map("audio_url")
  createdAt       DateTime @default(now()) @map("created_at")

  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examVersions    ExamVersionItem[]
  answers         Answer[]

  @@unique([questionId, versionNumber])
  @@map("question_versions")
}

model ExamVersion {
  id            String            @id @default(uuid())
  examId        String            @map("exam_id")
  versionNumber Int               @map("version_number")
  title         String
  totalPoints   Float             @default(0) @map("total_points")
  createdAt     DateTime          @default(now()) @map("created_at")

  exam          Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  items         ExamVersionItem[]
  submissions   ExamSubmission[]

  @@unique([examId, versionNumber])
  @@map("exam_versions")
}

model ExamVersionItem {
  id                String          @id @default(uuid())
  examVersionId     String          @map("exam_version_id")
  questionVersionId String          @map("question_version_id")
  sectionOrder      Int             @default(0) @map("section_order")
  groupOrder        Int             @default(0) @map("group_order")
  questionOrder     Int             @default(0) @map("question_order")

  examVersion       ExamVersion     @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)

  @@unique([examVersionId, questionVersionId])
  @@map("exam_version_items")
}

model AnswerEvaluationEvidence {
  id               String   @id @default(uuid())
  answerId         String   @unique @map("answer_id")
  evaluatorType    String   @map("evaluator_type")
  evaluatorVersion String   @default("1.0.0") @map("evaluator_version")
  rawSubmitted     String?  @map("raw_submitted")
  normalizedInput  String?  @map("normalized_input")
  matchedRule      String?  @map("matched_rule")
  isCorrect        Boolean  @map("is_correct")
  scoreAwarded     Float    @map("score_awarded")
  maxScore         Float    @map("max_score")
  evaluatedAt      DateTime @default(now()) @map("evaluated_at")

  answer           Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  @@map("answer_evaluation_evidences")
}


